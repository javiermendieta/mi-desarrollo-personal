generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AIProfile {
  id                String   @id
  userId            String   @unique
  personality       String?
  lifeGoals         String?
  currentChallenges String?
  values            String?
  interests         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  User              User     @relation(fields: [userId], references: [id])
}

model AccountPlanItem {
  id          String   @id
  userId      String
  code        String?
  name        String
  type        String
  category    String?
  subcategory String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isDefault   Boolean  @default(false)
  section     String   @default("gross_sales")
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, section])
  @@index([userId, type])
}

model Activity {
  id          String   @id
  userId      String
  type        String
  action      String
  referenceId String?
  title       String
  details     Json?
  date        DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([userId, type])
}

model Book {
  id          String    @id
  userId      String
  title       String
  author      String?
  totalPages  Int
  currentPage Int       @default(0)
  startDate   DateTime  @default(now())
  finishDate  DateTime?
  status      String    @default("reading")
  notes       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  pdfUrl      String?
  pdfName     String?
  User        User      @relation(fields: [userId], references: [id])
}

model Budget {
  id          String   @id
  userId      String
  category    String
  limitAmount Float
  month       String
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, month])
}

model CalendarEvent {
  id                String    @id
  userId            String
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  color             String    @default("#3b82f6")
  category          String    @default("Personal")
  isRecurring       Boolean   @default(false)
  recurrencePattern String?
  recurrenceEnd     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  User              User      @relation(fields: [userId], references: [id])

  @@index([userId, startDate])
}

model CommercialLead {
  id          String   @id
  userId      String
  name        String
  company     String?
  email       String?
  phone       String?
  source      String?
  status      String   @default("new")
  value       Float?
  probability Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Conversation {
  id        String   @id
  userId    String
  title     String   @default("Nueva conversación")
  messages  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model DiaryEntry {
  id        String   @id
  userId    String
  date      DateTime
  title     String?
  content   String
  mood      String   @default("good")
  tags      Json?
  gratitude Json?
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Goal {
  id          String    @id
  userId      String
  title       String
  description String?
  timeframe   String    @default("short")
  category    String    @default("personal")
  deadline    DateTime?
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  milestones  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id])
}

model Habit {
  id          String   @id
  userId      String
  name        String
  description String?
  icon        String   @default("check")
  color       String   @default("#22c55e")
  frequency   String   @default("daily")
  customDays  Json?
  isActive    Boolean  @default(true)
  logs        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])
}

model HealthEntry {
  id        String   @id
  userId    String
  date      DateTime
  weight    Float?
  steps     Int?
  calories  Int?
  notes     String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model HydrationLog {
  id        String   @id
  userId    String
  date      DateTime
  glasses   Int      @default(0)
  target    Int      @default(8)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model LimitingBelief {
  id          String   @id
  userId      String
  belief      String
  explanation String?
  dailyWork   String?
  progress    Int      @default(0)
  isOvercome  Boolean  @default(false)
  reflections Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])
}

model MedicalAppointment {
  id        String   @id
  userId    String
  doctor    String?
  specialty String?
  date      DateTime
  location  String?
  notes     String?
  status    String   @default("scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime
  title     String?
  time      String?  @default("10:00")
  reminder  Boolean? @default(false)
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model MedicalTask {
  id          String    @id
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  priority    String    @default("medium")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  category    String?   @default("other")
  notes       String?
  User        User      @relation(fields: [userId], references: [id])

  @@index([userId, dueDate])
}

model MeditationSession {
  id        String   @id
  userId    String
  date      DateTime
  duration  Int
  type      String   @default("mindfulness")
  notes     String?
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model PNLData {
  id           String   @id
  userId       String
  period       String
  accountPlans Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id])

  @@unique([userId, period])
}

model Project {
  id          String    @id
  userId      String
  name        String
  description String?
  client      String?
  status      String    @default("active")
  type        String    @default("client")
  startDate   DateTime?
  endDate     DateTime?
  color       String    @default("#3b82f6")
  tasks       Json?
  milestones  Json?
  documents   Json?
  meetings    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model ProjectAlert {
  id          String   @id
  userId      String
  projectId   String?
  type        String
  title       String
  message     String?
  severity    String   @default("info")
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model QuickNote {
  id        String   @id
  userId    String
  title     String
  content   String?
  category  String   @default("Otros")
  color     String   @default("#ffffff")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model SavingsGoal {
  id            String    @id
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  User          User      @relation(fields: [userId], references: [id])
}

model Settings {
  id            String   @id
  userId        String   @unique
  theme         String   @default("system")
  language      String   @default("es")
  notifications Boolean  @default(true)
  weekStartsOn  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  User          User     @relation(fields: [userId], references: [id])
}

model SleepLog {
  id        String   @id
  userId    String
  date      DateTime
  sleepTime String?
  wakeTime  String?
  quality   Int      @default(3)
  notes     String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model SocialMediaPost {
  id          String    @id
  userId      String
  platform    String
  content     String
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  mediaUrl    String?
  tags        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id])

  @@index([userId, platform])
  @@index([userId, scheduledAt])
}

model Sport {
  id        String   @id
  userId    String
  name      String
  icon      String   @default("dumbbell")
  color     String   @default("#22c55e")
  isActive  Boolean  @default(true)
  routines  Json?
  sessions  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id
  userId      String
  type        String
  amount      Float
  category    String   @default("other")
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  accountId   String?
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model User {
  id                 String               @id
  email              String               @unique
  password           String
  name               String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  AIProfile          AIProfile?
  AccountPlanItem    AccountPlanItem[]
  Activity           Activity[]
  Book               Book[]
  Budget             Budget[]
  CalendarEvent      CalendarEvent[]
  CommercialLead     CommercialLead[]
  Conversation       Conversation[]
  DiaryEntry         DiaryEntry[]
  Goal               Goal[]
  Habit              Habit[]
  HealthEntry        HealthEntry[]
  HydrationLog       HydrationLog[]
  LimitingBelief     LimitingBelief[]
  MedicalAppointment MedicalAppointment[]
  MedicalTask        MedicalTask[]
  MeditationSession  MeditationSession[]
  PNLData            PNLData[]
  Project            Project[]
  ProjectAlert       ProjectAlert[]
  QuickNote          QuickNote[]
  SavingsGoal        SavingsGoal[]
  Settings           Settings?
  SleepLog           SleepLog[]
  SocialMediaPost    SocialMediaPost[]
  Sport              Sport[]
  Transaction        Transaction[]
  YogaExercise       YogaExercise[]
  YogaSession        YogaSession[]
  SpiritualPractice  SpiritualPractice[]
  SpiritualPanicLog  SpiritualPanicLog[]
  SpiritualSettings  SpiritualSettings?
}

model YogaExercise {
  id          String   @id
  userId      String
  name        String
  description String?
  duration    Int      @default(10)
  difficulty  String   @default("beginner")
  category    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])
}

model YogaSession {
  id        String   @id
  userId    String
  date      DateTime
  duration  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

// ==================== SPIRITUAL MODULE ====================
model SpiritualPractice {
  id          String   @id
  userId      String
  name        String
  type        String   // rosary, prayer, mass, confession, bible, adoration, fasting, via_crucis
  icon        String   @default("cross")
  color       String   @default("#8B5CF6")
  schedule    String?  // Horario configurado (HH:mm)
  isActive    Boolean  @default(true)
  logs        Json?    // [{date: "2024-01-15", completed: true, notes: "..."}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

model SpiritualPanicLog {
  id        String   @id
  userId    String
  date      DateTime @default(now())
  message   String
  notes     String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model SpiritualSettings {
  id        String   @id
  userId    String   @unique
  level     String   @default("beginner") // beginner, intermediate, advanced, contemplative
  phrases   Json?    // Array de frases personalizadas
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}
